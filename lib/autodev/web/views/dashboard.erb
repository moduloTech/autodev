<h1><%= h(t_web(:web_dashboard_title)) %></h1>

<h2><%= h(t_web(:web_dashboard_counters)) %></h2>
<table>
  <tr>
    <th><%= h(t_web(:web_col_status)) %></th><th><%= h(t_web(:web_col_total)) %></th>
  </tr>
  <% Dashboard::STATUS_COLORS.keys.each do |status| %>
    <% count = @counts[status] || 0 %>
    <% next if count.zero? %>
    <tr>
      <td><a href="/list/<%= h(status) %>"><span class="<%= status_class(status) %>"><%= h(status) %></span> <span class="muted"><%= h(status_label(status)) %></span></a></td>
      <td><a href="/list/<%= h(status) %>"><%= count %></a></td>
    </tr>
  <% end %>
</table>

<h2><%= h(t_web(:web_dashboard_active_issues, count: @active.size)) %></h2>
<% if @active.empty? %>
  <p class="muted"><%= h(t_web(:web_dashboard_no_active)) %></p>
<% else %>
  <% @grouped.each do |status, rows| %>
    <h3><span class="<%= status_class(status) %>"><%= h(status) %></span> <span class="muted"><%= h(status_label(status)) %></span> (<%= rows.size %>)</h3>
    <table>
      <tr><th><%= h(t_web(:web_col_project)) %></th><th><%= h(t_web(:web_col_iid)) %></th><th><%= h(t_web(:web_col_title)) %></th><th><%= h(t_web(:web_col_branch)) %></th><th><%= h(t_web(:web_col_mr)) %></th></tr>
      <% rows.each do |row| %>
        <tr>
          <td><a href="/projects/<%= h(project_slug(row[:project_path])) %>"><%= h(row[:project_path]) %></a></td>
          <td><a href="/issues/<%= row[:id] %>">#<%= row[:issue_iid] %></a></td>
          <td><%= h(row[:issue_title]) %></td>
          <td><code><%= h(row[:branch_name]) %></code></td>
          <td><% if row[:mr_url] && !row[:mr_url].empty? %><a href="<%= h(row[:mr_url]) %>" target="_blank">!<%= row[:mr_iid] %></a><% end %></td>
        </tr>
      <% end %>
    </table>
  <% end %>
<% end %>

<h2><%= h(t_web(:web_dashboard_by_project)) %></h2>
<% if @by_project.empty? %>
  <p class="muted"><%= h(t_web(:web_dashboard_no_project)) %></p>
<% else %>
  <table>
    <tr><th><%= h(t_web(:web_col_project)) %></th><th><%= h(t_web(:web_col_total)) %></th><th><%= h(t_web(:web_col_active)) %></th><th><%= h(t_web(:web_col_done)) %></th><th><%= h(t_web(:web_col_error)) %></th></tr>
    <% @by_project.each do |stats| %>
      <tr>
        <td><a href="/projects/<%= h(project_slug(stats[:path])) %>"><%= h(stats[:path]) %></a></td>
        <td><%= stats[:total] %></td>
        <td><%= stats[:active] %></td>
        <td><%= stats[:done] %></td>
        <td><%= stats[:error] %></td>
      </tr>
    <% end %>
  </table>
<% end %>
