<h1><%= h(t_web(:web_issues_title)) %></h1>

<form method="get" action="/issues" style="margin-bottom: 1rem; display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: end;">
  <label><%= h(t_web(:web_issues_search)) %>
    <input type="text" name="q" value="<%= h(@filters[:q]) %>" placeholder="<%= h(t_web(:web_issues_search_placeholder)) %>" style="min-width: 14rem">
  </label>
  <label><%= h(t_web(:web_issues_from)) %>
    <input type="date" name="from" value="<%= h(@filters[:from]) %>">
  </label>
  <label><%= h(t_web(:web_issues_to)) %>
    <input type="date" name="to" value="<%= h(@filters[:to]) %>">
  </label>
  <label><%= h(t_web(:web_issues_per_page)) %>
    <select name="per_page">
      <% Web::IssuesFilter::PER_PAGE_OPTIONS.each do |opt| %>
        <option value="<%= opt %>"<%= ' selected' if opt == @per_page %>><%= opt %></option>
      <% end %>
    </select>
  </label>
  <button type="submit"><%= h(t_web(:web_issues_filter)) %></button>
  <a href="/issues" class="muted"><%= h(t_web(:web_issues_reset)) %></a>
</form>

<p class="muted">
  <%= h(t_web(:web_issues_count_paginated, count: @total, page: @page, total: @total_pages)) %>
</p>

<% if @issues.empty? %>
  <p class="muted"><%= h(t_web(:web_issues_no_match)) %></p>
<% else %>
  <table>
    <tr><th><%= h(t_web(:web_col_project)) %></th><th><%= h(t_web(:web_col_iid)) %></th><th><%= h(t_web(:web_col_status)) %></th><th><%= h(t_web(:web_col_title)) %></th><th><%= h(t_web(:web_col_created_at)) %></th><th><%= h(t_web(:web_col_mr)) %></th></tr>
    <% @issues.each do |row| %>
      <tr>
        <td><a href="/projects/<%= h(project_slug(row[:project_path])) %>"><%= h(row[:project_path]) %></a></td>
        <td><a href="/issues/<%= row[:id] %>">#<%= row[:issue_iid] %></a></td>
        <td><span class="<%= status_class(row[:status]) %>"><%= h(row[:status]) %></span></td>
        <td><%= h(row[:issue_title]) %></td>
        <td class="muted"><%= h(row[:created_at]) %></td>
        <td><% if row[:mr_url] && !row[:mr_url].empty? %><a href="<%= h(row[:mr_url]) %>" target="_blank">!<%= row[:mr_iid] %></a><% end %></td>
      </tr>
    <% end %>
  </table>

  <% if @total_pages > 1 %>
    <p>
      <% if @page > 1 %>
        <a href="?<%= URI.encode_www_form(@filters.merge(per_page: @per_page, page: @page - 1).reject { |_, v| v.nil? || v == '' }) %>"><%= h(t_web(:web_issues_prev)) %></a>
      <% end %>
      <span class="muted"> <%= h(t_web(:web_issues_page_indicator, page: @page, total: @total_pages)) %> </span>
      <% if @page < @total_pages %>
        <a href="?<%= URI.encode_www_form(@filters.merge(per_page: @per_page, page: @page + 1).reject { |_, v| v.nil? || v == '' }) %>"><%= h(t_web(:web_issues_next)) %></a>
      <% end %>
    </p>
  <% end %>
<% end %>
