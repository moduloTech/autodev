<h1>Toutes les issues</h1>

<form method="get" action="/issues" style="margin-bottom: 1rem; display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: end;">
  <label>Recherche
    <input type="text" name="q" value="<%= h(@filters[:q]) %>" placeholder="mot-clé dans le titre" style="min-width: 14rem">
  </label>
  <label>Du
    <input type="date" name="from" value="<%= h(@filters[:from]) %>">
  </label>
  <label>Au
    <input type="date" name="to" value="<%= h(@filters[:to]) %>">
  </label>
  <label>Par page
    <select name="per_page">
      <% Web::IssuesFilter::PER_PAGE_OPTIONS.each do |opt| %>
        <option value="<%= opt %>"<%= ' selected' if opt == @per_page %>><%= opt %></option>
      <% end %>
    </select>
  </label>
  <button type="submit">Filtrer</button>
  <a href="/issues" class="muted">Réinitialiser</a>
</form>

<p class="muted">
  <%= @total %> issue(s) — page <%= @page %> / <%= @total_pages %>
</p>

<% if @issues.empty? %>
  <p class="muted">Aucune issue ne correspond à ces filtres.</p>
<% else %>
  <table>
    <tr><th>Projet</th><th>IID</th><th>Status</th><th>Titre</th><th>Créée le</th><th>MR</th></tr>
    <% @issues.each do |row| %>
      <tr>
        <td><a href="/projects/<%= h(project_slug(row[:project_path])) %>"><%= h(row[:project_path]) %></a></td>
        <td><a href="/issues/<%= row[:id] %>">#<%= row[:issue_iid] %></a></td>
        <td><span class="<%= status_class(row[:status]) %>"><%= h(row[:status]) %></span></td>
        <td><%= h(row[:issue_title]) %></td>
        <td class="muted"><%= h(row[:created_at]) %></td>
        <td><% if row[:mr_url] && !row[:mr_url].empty? %><a href="<%= h(row[:mr_url]) %>" target="_blank">!<%= row[:mr_iid] %></a><% end %></td>
      </tr>
    <% end %>
  </table>

  <% if @total_pages > 1 %>
    <p>
      <% if @page > 1 %>
        <a href="?<%= URI.encode_www_form(@filters.merge(per_page: @per_page, page: @page - 1).reject { |_, v| v.nil? || v == '' }) %>">← Précédent</a>
      <% end %>
      <span class="muted"> Page <%= @page %> / <%= @total_pages %> </span>
      <% if @page < @total_pages %>
        <a href="?<%= URI.encode_www_form(@filters.merge(per_page: @per_page, page: @page + 1).reject { |_, v| v.nil? || v == '' }) %>">Suivant →</a>
      <% end %>
    </p>
  <% end %>
<% end %>
