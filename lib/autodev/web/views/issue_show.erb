<h1>Issue #<%= @issue[:issue_iid] %> — <%= h(@issue[:project_path]) %></h1>

<p>
  <span id="status_<%= @issue[:id] %>" class="<%= status_class(@issue[:status]) %>"><%= h(@issue[:status]) %></span>
  <span class="muted"><%= h(status_label(@issue[:status])) %></span>
</p>

<p><%= h(@issue[:issue_title]) %></p>

<h2>Liens</h2>
<ul>
  <% if (url = gitlab_issue_url(@issue)) %><li><a href="<%= h(url) %>" target="_blank">Issue GitLab</a></li><% end %>
  <% if (url = gitlab_mr_url(@issue)) %><li><a href="<%= h(url) %>" target="_blank">Merge Request !<%= @issue[:mr_iid] %></a></li><% end %>
</ul>

<h2>Métadonnées</h2>
<table>
  <tr><td>Branche</td><td><code><%= h(@issue[:branch_name]) %></code></td></tr>
  <tr><td>Locale</td><td><%= h(@issue[:locale] || 'fr') %></td></tr>
  <tr><td>Retry count</td><td><%= @issue[:retry_count] %></td></tr>
  <tr><td>Review count</td><td><%= @issue[:review_count] %></td></tr>
  <tr><td>Pipeline retriggers</td><td><%= @issue[:pipeline_retrigger_count] %></td></tr>
  <tr><td>Started at</td><td><%= h(@issue[:started_at]) %></td></tr>
  <tr><td>Created at</td><td><%= h(@issue[:created_at]) %></td></tr>
  <% if @issue[:error_message] %><tr><td>Erreur</td><td><pre><%= h(@issue[:error_message]) %></pre></td></tr><% end %>
  <% if @issue[:post_completion_error] %><tr><td>Post-completion erreur</td><td><pre><%= h(@issue[:post_completion_error]) %></pre></td></tr><% end %>
</table>

<h2>Actions</h2>
<form method="post" action="/issues/<%= @issue[:id] %>/reset" onsubmit="return confirm('Reset cette issue à pending ?');" style="display: inline">
  <button type="submit">Reset</button>
</form>

<% events = permitted_events_for(@issue_model) %>
<% if events.any? %>
  <form method="post" action="/issues/<%= @issue[:id] %>/transition" onsubmit="return confirm('Forcer la transition ' + this.event.value + ' ?');" style="display: inline">
    <select name="event">
      <% events.each do |ev| %><option value="<%= h(ev) %>"><%= h(ev) %></option><% end %>
    </select>
    <button type="submit">Forcer la transition</button>
  </form>
<% else %>
  <p class="muted">Aucune transition AASM permise depuis <code><%= h(@issue[:status]) %></code>.</p>
<% end %>

<h2>Activity (<%= @events.size %>)</h2>
<% if @events.empty? %>
  <p class="muted">Aucun événement enregistré.</p>
<% else %>
  <table>
    <thead>
      <tr><th>Date</th><th>Type</th><th>Niveau</th><th>Détail</th></tr>
    </thead>
    <tbody id="events_<%= @issue[:id] %>">
      <% @events.each do |ev| %>
        <tr>
          <td class="muted"><%= h(ev[:created_at]) %></td>
          <td><code><%= h(ev[:kind]) %></code></td>
          <td><%= h(ev[:level]) %></td>
          <td><%= h(format_event(ev)) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% screenshots = screenshot_files(@issue) %>
<% if screenshots.any? %>
  <h2>Screenshots (<%= screenshots.size %>)</h2>
  <ul>
    <% screenshots.each do |path| %><li><code><%= h(path) %></code></li><% end %>
  </ul>
  <p class="muted">Stockés dans <code><%= h(screenshot_dir_for(@issue)) %></code>.</p>
<% end %>

<h2>Données brutes</h2>
<details>
  <summary>JSON</summary>
  <pre><%= h(JSON.pretty_generate(@issue)) %></pre>
</details>
