<h1><%= h(t_web(:web_errors_title)) %></h1>

<% if @errored.empty? %>
  <p class="muted"><%= h(t_web(:web_errors_none)) %></p>
<% else %>
  <table>
    <tr><th><%= h(t_web(:web_col_project)) %></th><th><%= h(t_web(:web_col_iid)) %></th><th><%= h(t_web(:web_col_status)) %></th><th><%= h(t_web(:web_col_message)) %></th><th></th></tr>
    <% @errored.each do |row| %>
      <tr>
        <td><a href="/projects/<%= h(project_slug(row[:project_path])) %>"><%= h(row[:project_path]) %></a></td>
        <td><a href="/issues/<%= row[:id] %>">#<%= row[:issue_iid] %></a></td>
        <td><span class="<%= status_class(row[:status]) %>"><%= h(row[:status]) %></span></td>
        <td>
          <% msg = row[:error_message] || row[:post_completion_error] %>
          <% if msg %><pre><%= h(msg.to_s[0, 400]) %></pre><% end %>
        </td>
        <td>
          <form method="post" action="/issues/<%= row[:id] %>/reset" onsubmit="return confirm('<%= t_web(:web_errors_confirm_reset, iid: row[:issue_iid]) %>');">
            <button type="submit"><%= h(t_web(:web_issue_reset)) %></button>
          </form>
        </td>
      </tr>
    <% end %>
  </table>
<% end %>
