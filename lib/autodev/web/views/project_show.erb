<h1><%= h(t_web(:web_project_title, path: @project_path)) %></h1>

<h2><%= t_web(:web_project_config) %></h2>
<% if @project_config.empty? %>
  <p class="muted"><%= h(t_web(:web_project_no_config)) %></p>
<% else %>
  <pre><%= h(YAML.dump(@project_config)) %></pre>
<% end %>

<h2><%= h(t_web(:web_project_recent, count: @project_issues.size)) %></h2>
<% if @project_issues.empty? %>
  <p class="muted"><%= h(t_web(:web_project_no_issues)) %></p>
<% else %>
  <table>
    <tr><th><%= h(t_web(:web_col_iid)) %></th><th><%= h(t_web(:web_col_status)) %></th><th><%= h(t_web(:web_col_title)) %></th><th><%= h(t_web(:web_col_branch)) %></th><th><%= h(t_web(:web_col_mr)) %></th></tr>
    <% @project_issues.each do |row| %>
      <tr>
        <td><a href="/issues/<%= row[:id] %>">#<%= row[:issue_iid] %></a></td>
        <td><span class="<%= status_class(row[:status]) %>"><%= h(row[:status]) %></span></td>
        <td><%= h(row[:issue_title]) %></td>
        <td><code><%= h(row[:branch_name]) %></code></td>
        <td><% if row[:mr_url] && !row[:mr_url].empty? %><a href="<%= h(row[:mr_url]) %>" target="_blank">!<%= row[:mr_iid] %></a><% end %></td>
      </tr>
    <% end %>
  </table>
<% end %>
