#!/usr/bin/env ruby
# frozen_string_literal: true

# =============================================================================
# autodev
#
# Automated implementation of GitLab issues labelled with a trigger label.
# Polls configured projects, clones the repo, implements via danger-claude,
# commits, pushes, manages labels, creates a Merge Request, and optionally
# runs mr-review in headless mode.
#
# Usage:
#   autodev                                                # Supervisor (default)
#   autodev --status                                       # Dashboard of tracked issues
#   autodev --errors [IID]                                 # Details for errored/blocked issues
#   autodev --reset [IID]                                  # Reset errored issues to pending
#   autodev --seed-admin EMAIL                             # Seed an admin User
#   autodev --sync-memberships                             # Reconcile project_memberships
#   autodev --link-user EMAIL,GITLAB_USERNAME              # Override gitlab_username
#   autodev -c ~/.autodev/custom.yml                       # Custom config path
#
# Embedded web UI:
#   autodev exposes a live monitoring UI on http://<web.bind>:<web.port>
#   (defaults 127.0.0.1:4567). Set `web.bind: 0.0.0.0` (or a NetBird interface
#   IP) to expose it beyond loopback.
#   Set `AUTODEV_WEB_RELOAD=1` to hot-reload Sinatra routes + Phlex views
#   on every request (dev only — restart still required for poller / DB code).
#
# Configuration (priority: defaults < config.yml < env vars < CLI flags):
#   ~/.autodev/config.yml    Central config file
#   GITLAB_API_TOKEN         Personal Access Token with api scope
# =============================================================================

# Pin Bundler to the app's Gemfile before anything else. When installed via
# Homebrew, `autodev` runs from /opt/homebrew/Cellar/autodev/<ver>/bin/ —
# `__dir__` resolves there, and `../Gemfile` is the bundled Gemfile that
# `bundle install` populated `vendor/bundle/` from at install time. Without
# this, `require 'bundler/setup'` (called transitively by Rails) walks up
# from the user's CWD, finds an unrelated project's Gemfile, and crashes.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

require 'optparse'

# The parent CLI process boots the Rails environment so AR `Issue` /
# `ActivityEvent` and the workflow classes under `lib/autodev/` are
# available for `--status` / `--errors` / `--reset` and for the supervisor.
ENV['RAILS_ENV'] ||= 'production'
require_relative '../config/environment'
require_relative '../lib/autodev/supervisor'

# == Argument parsing ==========================================================

def parse_args(argv)
  cli_overrides = {}
  build_option_parser(cli_overrides).parse(argv)
  Config.load(cli_overrides)
end

def build_option_parser(cli_overrides)
  OptionParser.new do |opts|
    opts.banner = 'Usage: autodev [options]'
    define_connection_options(opts, cli_overrides)
    define_mode_options(opts, cli_overrides)
    define_query_options(opts, cli_overrides)
    define_info_options(opts)
  end
end

def define_connection_options(opts, overrides)
  opts.on('-c', '--config PATH', 'Config file (default: ~/.autodev/config.yml)') { |v| overrides['config_path'] = v }
  opts.on('-t', '--token TOKEN', 'GitLab API token') { |v| overrides['gitlab_token'] = v }
  opts.on('-n', '--max-workers N', Integer, 'Concurrent workers (default: 3)') { |v| overrides['max_workers'] = v }
  opts.on('-i', '--interval SECONDS', Integer, 'Poll interval in seconds') { |v| overrides['poll_interval'] = v }
end

def define_mode_options(_opts, _overrides)
  # --once and --dry-run were removed when phase C closed: the threaded
  # `Poller` they relied on is gone, and the supervisor is the only run
  # mode. Use `bin/rails runner 'AutodevPollJob.perform_now'` for a
  # one-shot poll cycle.
end

def define_query_options(opts, overrides)
  define_status_options(opts, overrides)
  define_reset_and_errors_options(opts, overrides)
  define_ops_options(opts, overrides)
end

def define_ops_options(opts, overrides) # rubocop:disable Metrics/MethodLength
  opts.on('--seed-admin EMAIL', 'Seed an admin User by email and exit') do |email|
    overrides['seed_admin'] = true
    overrides['seed_admin_email'] = email
  end
  opts.on('--sync-memberships',
          'Reconcile project_memberships against GitLab for every user and exit') do
    overrides['sync_memberships'] = true
  end
  opts.on('--link-user EMAIL,GITLAB_USERNAME', Array,
          'Override the GitLab username for a User (resets gitlab_user_id; next sync resolves it)') do |pair|
    abort '--link-user expects EMAIL,GITLAB_USERNAME (comma-separated, no spaces)' if pair.size != 2
    overrides['link_user'] = true
    overrides['link_user_email'] = pair[0]
    overrides['link_user_username'] = pair[1]
  end
end

def define_status_options(opts, overrides)
  opts.on('--status', 'Show dashboard of active issues and exit') { overrides['status'] = true }
  opts.on('--all', 'Include completed (over) issues in --status') { overrides['status_all'] = true }
end

def define_reset_and_errors_options(opts, overrides)
  opts.on('--reset [IID]', Integer, 'Reset error issues to pending (optionally by issue IID)') do |iid|
    overrides['reset'] = true
    overrides['reset_iid'] = iid
  end
  opts.on('--errors [IID]', Integer,
          'Show details for errored and blocked issues (optionally for a specific issue IID)') do |iid|
    overrides['errors'] = true
    overrides['errors_iid'] = iid
  end
end

def define_info_options(opts)
  opts.on('-v', '--version', 'Show version and exit') do
    puts "autodev #{Autodev::VERSION}"
    exit 0
  end
  opts.on('-h', '--help', 'Show this help') do
    puts opts
    exit 0
  end
end

# == Early commands ============================================================

def handle_early_commands(config, pastel) # rubocop:disable Metrics/MethodLength,Metrics/AbcSize
  run_early_command(config, pastel, 'status') { Dashboard.show(config) }
  run_early_command(config, pastel, 'errors') { Dashboard.show_errors(config) }
  run_early_command(config, pastel, 'reset') { Dashboard.reset(config, pastel) }
  run_early_command(config, pastel, 'seed_admin') do
    puts Autodev::OpsCommands.seed_admin(email: config.fetch('seed_admin_email'))
  end
  run_early_command(config, pastel, 'sync_memberships') do
    puts Autodev::OpsCommands.sync_memberships
  end
  run_early_command(config, pastel, 'link_user') do
    puts Autodev::OpsCommands.link_user(
      email: config.fetch('link_user_email'),
      gitlab_username: config.fetch('link_user_username')
    )
  end
end

def run_early_command(config, _pastel, key)
  return unless config[key]

  yield
  exit 0
end

# == Setup =====================================================================

def offer_template_config(config_path, logger, pastel)
  return if File.exist?(config_path)

  logger.warn("No config file found at #{config_path}")
  print pastel.bold('  Create a template config to edit? [Y/n] ')
  answer = $stdin.gets&.strip&.downcase
  unless answer.nil? || answer.empty? || answer == 'y'
    raise ConfigError, "No config file at #{config_path}. Create one manually or re-run to generate a template."
  end

  write_template_config(config_path, logger)
end

def write_template_config(config_path, logger)
  FileUtils.mkdir_p(File.dirname(config_path))
  File.write(config_path, Config::TEMPLATE)
  logger.info("Created #{config_path}")
  logger.info('Edit this file with your GitLab URL, token and projects, then re-run autodev.')
  exit 0
end

def validate_config(config, config_path, logger)
  validate_config_entries(config, config_path)
  Config.validate!(config)
  check_dependencies(logger)
end

def validate_config_entries(config, config_path)
  # Projects now live in the DB (task #9). Accept a project from either the
  # `projects` table (the authoritative source — add one in the dashboard or
  # seed via `bin/rails autodev:migrate_projects_from_yaml`) or a still-present
  # YAML `projects:` block (deprecated fallback).
  unless Project.exists? || (config['projects'].is_a?(Array) && config['projects'].any?)
    raise ConfigError, 'No projects configured. Add one in the dashboard (Projets → Nouveau projet) ' \
                       "or seed from #{config_path} with `bin/rails autodev:migrate_projects_from_yaml`."
  end

  return if config['gitlab_url'] && config['gitlab_url'] != 'https://gitlab.example.com'

  raise ConfigError, "Set a valid gitlab_url in #{config_path}"
end

def check_dependencies(logger)
  _, dc_status = Open3.capture2e('which', 'danger-claude')
  raise ConfigError, 'danger-claude is not installed or not on PATH' unless dc_status.success?

  _, mr_status = Open3.capture2e('which', 'mr-review')
  logger.warn('mr-review not installed, review step will be skipped') unless mr_status.success?
end

def setup_database(config, logger)
  # AR connections are configured via config/database.yml and the auto_migrate
  # initializer runs the migrations on Rails boot — by the time we reach
  # here `Issue` / `ActivityEvent` are ready. We only owe startup recovery
  # of any rows the previous process left in a transient state.
  reset_count = Issue.recover_on_startup!(max_retries: config['max_retries'])
  logger.warn("Recovered #{reset_count} issue(s) on startup") if reset_count.positive?
end

# == Main ======================================================================

def setup_chrome_devtools(config, logger)
  return unless Config.chrome_devtools_needed?(config)

  ChromeLauncher.ensure_running!(logger: logger)
  ChromeDevtoolsInjector.inject_mcp_config!(logger: logger)
end

def bootstrap(config, logger, pastel)
  logger.info('+=== autodev ================================================+')
  logger.configure(log_dir: config['log_dir'], level: config['log_level'])

  config_path = config['_config_path'] || Config::CONFIG_PATH
  offer_template_config(config_path, logger, pastel)
  validate_config(config, config_path, logger)
  setup_database(config, logger)
  setup_chrome_devtools(config, logger)
  warn_dev_recurring_disabled(logger, pastel)
  warn_stub_azure_credentials(config, logger, pastel)
end

# In RAILS_ENV=development, `config/recurring.yml` ships with an empty
# `development:` block — Solid Queue's scheduler boots but has no
# recurring tasks to fire, so a local supervisor doesn't act on
# production tickets while iterating on code. Print a banner so the
# operator knows nothing will auto-poll and can trigger jobs by hand.
def warn_dev_recurring_disabled(logger, pastel)
  return unless ENV['RAILS_ENV'] == 'development'

  logger.warn(pastel.bold('RAILS_ENV=development — recurring jobs are disabled.'))
  logger.warn('Trigger a poll cycle manually:')
  logger.warn("  #{pastel.cyan("bin/rails runner 'AutodevPollJob.perform_now'")}")
  logger.warn("  #{pastel.cyan("bin/rails runner 'SyncGitlabMembershipsJob.perform_now'")}")
end

# Detect the case where Azure SSO is unconfigured (or still on the
# `stub-client-id` fallback from `config/initializers/devise.rb`) — the
# OAuth handshake will reach Microsoft and fail with AADSTS700016, which
# is hard to diagnose from the consent-screen error alone. Warn early so
# the operator can fix `~/.autodev/config.yml` (or set `AZURE_AD_*` env
# vars) before clicking the sign-in button.
def warn_stub_azure_credentials(config, logger, pastel)
  return unless Config.azure_stub_credentials?(config)

  logger.warn(pastel.bold('Azure SSO credentials are not configured — sign-in will fail at Microsoft.'))
  logger.warn('Set them in ~/.autodev/config.yml under `azure:` (client_id, client_secret, tenant_id),')
  logger.warn('or via the AZURE_AD_CLIENT_ID / AZURE_AD_CLIENT_SECRET / AZURE_AD_TENANT_ID env vars.')
  return unless ENV['RAILS_ENV'] == 'development'

  callback_url = pastel.cyan('http://localhost:4567/users/auth/entra_id/callback')
  logger.warn("Also add #{callback_url} to the app's Redirect URIs in Entra ID.")
end

def log_or_warn(logger, msg)
  logger&.error(msg) || (warn msg)
end

def handle_fatal(error, logger)
  case error
  when ConfigError then log_or_warn(logger, "Config error: #{error.message}")
  when Interrupt   then logger&.warn('Interrupted.') || (warn 'Interrupted.')
  else
    log_or_warn(logger, "Unexpected error: #{error.class}: #{error.message}")
    logger&.error(error.backtrace.first(5).join("\n  ")) if error.backtrace
  end
  error.is_a?(Interrupt) ? exit(130) : exit(1)
end

def cleanup(logger)
  logger&.close
  # AR closes its own pool on Ruby exit via Rails' shutdown hooks. The
  # supervisor itself doesn't open business writes — its purpose is to
  # disconnect before forking children (handled inside run_supervisor).
end

# == Run modes =================================================================

# Default mode (no --once): the supervisor boots `bin/rails server` and
# `bin/jobs start` as child processes. The poll loop now lives inside Solid
# Queue (`AutodevPollJob` recurring per config/recurring.yml); WorkerPool
# is replaced by Solid Queue's worker pool tuned via config/queue.yml.
# `--once` was retired in step 2b — `bin/rails runner 'AutodevPollJob.perform_now'`
# is the one-shot equivalent now that the threaded Poller is gone.
def run_supervisor(config, logger)
  # Release the parent's AR connections so the children boot from scratch
  # against the same SQLite file without sharing pool state.
  ActiveRecord::Base.connection_handler.clear_active_connections!
  Autodev::Supervisor.new(
    children: build_supervisor_children(config),
    logger: logger
  ).run
end

def build_supervisor_children(config) # rubocop:disable Metrics/MethodLength
  env = supervisor_env(config)
  repo_root = File.expand_path('..', __dir__)
  # bin/rails and bin/jobs are `#!/usr/bin/env ruby` scripts; both require
  # bundler/setup via config/boot.rb so the gemset resolves without an
  # explicit `bundle exec` wrapper (which would also force `bundle` onto
  # PATH — a constraint we don't want for Brew-distributed installs).
  [
    Autodev::Supervisor::Child.new(
      name: 'rails-server',
      command: [File.join(repo_root, 'bin/rails'),
                'server', '-p', config['web']['port'].to_s, '-b', config['web']['bind']],
      env: env
    ),
    Autodev::Supervisor::Child.new(
      name: 'solid-queue',
      command: [File.join(repo_root, 'bin/jobs'), 'start'],
      env: env
    )
  ]
end

# Environment exported to both children. We forward only what's needed for
# Solid Queue + Rails to find the right databases, pool sizes, and bundled
# Gemfile (so the children's Bundler doesn't walk up from the operator's
# CWD and pick up an unrelated Gemfile when autodev runs from /opt/homebrew).
def supervisor_env(config) # rubocop:disable Metrics/MethodLength
  {
    'AUTODEV_MAX_WORKERS' => config['max_workers'].to_s,
    'AUTODEV_POLL_INTERVAL' => config['poll_interval'].to_s,
    'AUTODEV_DB' => ENV.fetch('AUTODEV_DB', nil),
    'AUTODEV_QUEUE_DB' => ENV.fetch('AUTODEV_QUEUE_DB', nil),
    'AUTODEV_HOME' => ENV.fetch('AUTODEV_HOME', nil),
    'RAILS_ENV' => ENV.fetch('RAILS_ENV', 'production'),
    'BUNDLE_GEMFILE' => ENV.fetch('BUNDLE_GEMFILE', nil),
    # Forward Azure SSO credentials when the operator set them in their
    # shell. The canonical place is `~/.autodev/config.yml` under
    # `azure:` (read by `config/initializers/devise.rb`) — env vars are
    # a convenience override for one-off testing / debugging.
    'AZURE_AD_CLIENT_ID' => ENV.fetch('AZURE_AD_CLIENT_ID', nil),
    'AZURE_AD_CLIENT_SECRET' => ENV.fetch('AZURE_AD_CLIENT_SECRET', nil),
    'AZURE_AD_TENANT_ID' => ENV.fetch('AZURE_AD_TENANT_ID', nil)
  }.compact
end

def main
  pastel = Pastel.new
  logger = AppLogger.new(pastel: pastel)
  config = parse_args(ARGV)
  handle_early_commands(config, pastel)
  bootstrap(config, logger, pastel)
  run_supervisor(config, logger)
rescue StandardError, Interrupt => e
  handle_fatal(e, logger)
ensure
  cleanup(logger)
end

main
