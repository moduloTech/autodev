#!/usr/bin/env ruby
# frozen_string_literal: true

# Boots the Solid Queue supervisor — dispatches recurring tasks
# (config/recurring.yml) and runs enqueued jobs against the worker pool
# defined in config/queue.yml. Launched by the bin/autodev supervisor as
# its second child process (the first is `bin/rails server`).

# Pin Bundler to the bundled Gemfile (same Brew-cellar concern as bin/autodev).
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

require_relative '../config/environment'
require 'solid_queue/cli'

SolidQueue::Cli.start(ARGV)
